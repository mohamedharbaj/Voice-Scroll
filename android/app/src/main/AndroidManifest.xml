<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the essential permissions requested -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Android 11+ (package visibility): بلا هاد الجزء SpeechRecognizer.isRecognitionAvailable كيرجع false
         وما كيتلقى حتى خدمة تعرف على الصوت، وبالتالي التطبيق ما كيستجيب للأوامر -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".VoiceScrollApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceScroll">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TestVoiceActivity"
            android:exported="false"
            android:label="@string/title_test_voice"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/title_settings"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.CustomAliasesActivity"
            android:exported="false"
            android:label="@string/title_custom_aliases"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.PrivacyActivity"
            android:exported="false"
            android:label="@string/title_privacy"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/title_about"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Foreground Service for voice listening in background -->
        <service
            android:name=".service.VoiceScrollForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Accessibility Service for dispatching dynamic swipe gestures -->
        <service
            android:name="com.voicescroll.app.service.VoiceScrollAccessibilityService"
            android:description="@string/accessibility_service_description"
            android:enabled="true"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
